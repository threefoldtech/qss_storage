# qss_storage.toml -- configuration for s3cas and respcas.
#
# Copy this file to qss_storage.toml (working directory) or to
# /etc/qss_storage/qss_storage.toml, and delete what you do not need: every
# key below is optional, and an absent key falls back to the built-in default
# shown in its comment.
#
# Precedence, highest first:
#
#   1. CLI flags       (e.g. --port 9000)
#   2. this file       (--config <path>, then ./qss_storage.toml,
#                       then /etc/qss_storage/qss_storage.toml)
#   3. built-in defaults
#
# A --config path that does not exist is an error, not a fall-through. Unknown
# keys are an error too: a typo in a storage daemon's configuration should stop
# it, not be ignored.

# ---------------------------------------------------------------------------
# [store] -- how every store this deployment opens is created and opened.
# Both binaries read this table.
# ---------------------------------------------------------------------------
[store]

# Write durability: "fsync" or "buffer". Both are promises about what an
# acknowledgement means, and one syscall apart:
#
#   fsync   everything the ack covers -- block files and metadata records --
#           is on stable storage before the ack goes out (ADR 0010). Survives
#           a power cut.
#   buffer  everything the ack covers has been handed to the KERNEL before the
#           ack goes out: written, not flushed. Survives the daemon being
#           killed; lost only to a power cut or an OS crash.
#
# "buffer" is not "nothing is written". The write happens; only the flush is
# left to the page cache. That is enforced on every path that acknowledges,
# transactional or not (ADR 0011's rider), and not merely hoped for.
#
# There used to be a third level, "fdatasync". ADR 0010 removed it with no
# alias: once the sync boundary moved from the block to the ack, the two
# syscalls' cost difference is paid once per request instead of twice per MiB,
# and on the append-only journal fdatasync must flush the size metadata
# anyway. A config still naming it is refused at startup.
# Default: "fsync"
durability = "fsync"

# Objects (s3cas) or values (respcas) at or below this many bytes are stored
# inside their metadata record instead of as blocks. Leave the key out for the
# backend default. respcas defaults to 1, which inlines everything it can.
# Default: unset for s3cas, 1 for respcas
#inline_metadata_size = 1

# Metadata database backend. "fjall" is the only backend; the former
# "fjall_notx" was removed (ADR 0007) -- for a fast-and-loose tier use
# durability = "buffer" instead.
# respcas ignores this key: it is fjall-only.
# Default: "fjall"
metadata_db = "fjall"

# Re-hash each whole block on read and refuse to serve one whose bytes no
# longer hash to its address. Costs a full buffer plus a hash per block, and
# covers whole-object reads only (a range request cannot be re-hashed against
# a whole-block address). respcas ignores this key: it stores no blocks.
# Default: false
verify_on_read = false

# Number of per-block lock stripes (ADR 0006). Every block-record mutation runs
# under the stripe of the block's hash, so writers of the same block serialize
# and writers of different blocks do not -- except when two unrelated blocks
# land on the same stripe. With K concurrent block writers and N stripes that
# false sharing happens with probability about (K-1)/N, so size N to roughly
# 16x the peak concurrent block writers: the default 1024 keeps it under ~6% at
# K=64.
#
# Purely a concurrency knob -- nothing about it is written to disk, so it can
# change between restarts, and two processes may open the same store with
# different counts. Must be between 1 and 65536: 0 would put every block writer
# on a single lock, and the stripe index is taken from two bytes of the block
# hash, so stripes past 65536 are allocated and never used.
# respcas ignores this key: it stores no blocks.
# Default: 1024
stripe_count = 1024

# Most block records one transaction carries (ADR 0010). One request -- a part
# upload, a single-part PUT -- is one durability unit: its block files are made
# durable as a group, then all of its block records commit in ONE transaction
# with ONE journal fsync, and only then does the client see success. A request
# holding more blocks than this becomes several consecutive batches, the last
# one closing at the ack; a request holding fewer is a single batch, so a
# one-block PUT costs exactly what it always did.
#
# The tradeoff this knob moves: a larger cap amortizes the journal fsync over
# more blocks (that is the throughput), a smaller one shortens how long a batch
# holds its stripes and narrows the crash residue. A kill between a batch's
# directory sync and its commit leaves up to this many orphan block files --
# residue class 1, which fsck collects and a later PUT of the same content
# heals in place. Nothing here is written to disk: change it freely between
# restarts. 1 means one commit per block, the cadence from before ADR 0010.
# respcas ignores this key: it stores no blocks.
# Default: 64
max_blocks_per_commit = 64

# Merge the closing step of CONCURRENT requests into one transaction with one
# journal persist (ADR 0011). Off, the write path is ADR 0010's exactly: every
# request closes its own batch. On, a request hands its batch -- files already
# staged and fdatasynced -- to a per-store commit station and parks; the
# committer takes whatever is queued, renames every member's files, syncs each
# touched directory once, and commits everyone's block records in ONE
# transaction with ONE persist.
#
# What it buys: small objects and lone streams, which pay a full persist per
# request today. A thousand concurrent 4 KiB PUTs become roughly one persist
# per group instead of a thousand.
#
# What it costs: strangers share a commit. A member waits on other requests'
# renames and one shared persist, and a device hiccup mid-persist stalls
# everyone parked instead of one request. If the shared transaction fails it
# rolls back and every member is replayed on its own, so one bad member fails
# alone -- but the coupling is real, which is why this is opt-in and off by
# default.
#
# A group never carries more than max_blocks_per_commit blocks: the cap above
# stays the one and only bound on transaction size, stripe hold time and crash
# residue. Grouping does not make the transaction bigger, it lets strangers
# fill a cap a small request would have wasted.
# respcas ignores this key: it stores no blocks.
# Default: false
group_commit = false

# Extra time the committer spends gathering members after the FIRST one
# arrives, as a duration with a unit ("0ms", "250us", "2ms").
#
# LEAVE THIS ALONE UNLESS YOU MEASURED. Zero -- the default -- means there is
# no timer: groups are whatever queued up while the previous group was
# committing, so a request that arrives to an idle committer commits
# immediately and group commit adds nothing at all to a lone ack. A non-zero
# window delays every ack by up to this long in exchange for bigger groups,
# and the deadline runs from the first member of a group, never resets, so
# groups still close at the cap or the deadline, whichever comes first.
#
# The number to look at before touching it is the mean group size
# (s3_group_commit_members / s3_group_commits). Pinned at 1 under real load is
# the only thing this knob fixes.
# Ignored entirely when group_commit is false.
# Default: "0ms"
group_commit_window = "0ms"

# ---------------------------------------------------------------------------
# [store.hash] -- how blocks are addressed.
#
# Applies ONLY when a store is created. An existing store is addressed by the
# hash recorded in its (immutable) QSST header; if this section disagrees with
# the store that was opened, the header wins and s3cas logs a warning at
# startup. To change the hash of a deployment, create a new store.
# ---------------------------------------------------------------------------
[store.hash]

# Block hash algorithm. "blake3" is the only value this build accepts.
# Default: "blake3"
algo = "blake3"

# Block address width in bytes: 32 (256 bit, the default) or 16 (128 bit,
# truncated BLAKE3 -- smaller metadata, for trusted-tenant deployments).
# Default: 32
width = 32

# ---------------------------------------------------------------------------
# [s3] -- the s3cas server. respcas ignores this table.
# ---------------------------------------------------------------------------
[s3]

# Address the S3 endpoint binds. Default: "localhost"
host = "localhost"

# Port the S3 endpoint binds. Default: 8014
port = 8014

# S3 credentials. Authentication is mandatory: s3cas refuses to start unless
# both the access key and the secret key are supplied, here or on the command
# line (--access-key / --secret-key). There is no default.
access_key = "CHANGE_ME"
secret_key = "CHANGE_ME"

# s3cas reads --fs-root and --meta-root from the command line only; they have
# no key here. That is the design ruling, not an omission: the config file
# describes the store, the invocation places it, and a stale toml on the wrong
# host is exactly the accident the placement rules below exist to catch.
#
# The tiered layout (ADR 0012). The two roots ARE the placement mechanism, and
# putting them on different disks is a supported store shape:
#
#   --meta-root /nvme/store    the namespace databases (<meta>/db), the shared
#                              blocks database (<meta>/blocks/.db), and the
#                              header sidecars. Journal persists, compactions,
#                              dedup point reads, record walks: seek-heavy,
#                              small, and what an NVMe is for.
#   --fs-root   /hdd/store     the block files (<fs>/blocks/<aa>/../<hash>) and
#                              their staging directory. Whole 1 MiB files
#                              written once and streamed back: as sequential as
#                              object storage gets, which is what spinning rust
#                              is good at.
#
# One root for both (the default, --meta-root . --fs-root .) is unchanged and
# still correct; it just puts the databases inside the blocks root.
#
# The pairing is checked, not assumed. Each store has an id in its header, and
# the blocks root carries a copy in blocks/.store-id. A database opened against
# the WRONG data directory -- yesterday's, a sibling store's, a disk that
# failed to mount -- is refused at startup with both ids and both paths, and
# there is no override flag. A store made before this existed is adopted at
# first open (one log line, no action needed). If a pairing really is the one
# you meant and the marker disagrees, make it official with:
#
#   qss-storage-fsck --re-pair --meta-root /nvme/store --fs-root /hdd/store

# ---------------------------------------------------------------------------
# [s3.metrics] -- the prometheus endpoint, served by s3cas at /metrics.
# ---------------------------------------------------------------------------
[s3.metrics]

# Address the metrics endpoint binds. Default: "localhost"
host = "localhost"

# Port the metrics endpoint binds. Default: 9100
port = 9100

# ---------------------------------------------------------------------------
# [multipart] -- the multipart upload lifecycle. respcas ignores this table.
#
# A multipart upload that is never completed or aborted keeps its uploaded
# parts, and every block those parts reference, forever. s3cas sweeps them:
# uploads past the age below are aborted the same way a client's
# AbortMultipartUpload aborts them, and part records left with no upload
# (a crash, or an interrupted abort) are removed with their references.
# ---------------------------------------------------------------------------
[multipart]

# Age at which an unfinished upload is aborted, in days. The sweep runs every
# max(ttl/20, 1 hour), and the first one is a full period after startup rather
# than at boot. Set to 0 to disable it -- then nothing reclaims an abandoned
# upload until an operator runs a repair pass.
# Default: 7
stale_ttl_days = 7

# ---------------------------------------------------------------------------
# [resp] -- the respcas server. s3cas ignores this table.
# ---------------------------------------------------------------------------
[resp]

# Address respcas binds. Default: "127.0.0.1"
host = "127.0.0.1"

# Port respcas binds. Default: 6379
port = 6379

# Directory holding respcas's database. Created if missing.
# Default: "./data"
data_dir = "./data"

# Password required for admin commands. If this key is absent and --admin is
# not passed, every connection is granted admin privileges.
# Default: unset
#admin_password = "CHANGE_ME"
